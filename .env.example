# Plantilla de variables de entorno de VIE.
# Copia este archivo a .env (no se rastrea en git) y ajusta los valores.
# En Render las variables se configuran en el dashboard; el .env solo aplica en local.

# Base de datos. Postgres en produccion (Neon: postgresql://usuario:clave@host/db).
# Sin esta variable la app usa SQLite local (archivo vie.db).
VIE_DATABASE_URL=postgresql://usuario:clave@localhost:5432/vie

# Secreto para firmar sesiones y QR (HMAC). Genera uno con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VIE_SECRET=cambia-esto-por-un-secreto-largo

# 1 = cabeceras HSTS y cookies Secure (produccion con HTTPS). Dejar vacio en local http.
VIE_COOKIE_SECURE=

# 1 = limitador de intentos activo (login, escaneos, cambio de clave). 0 para pruebas.
VIE_RATE_LIMIT=1

# 1 = 2FA obligatorio para admin (produccion). 0 facilita pruebas locales.
VIE_ENFORCE_ADMIN_2FA=1

# Meses de retencion de visitas finalizadas/canceladas (SOC2/CC + habeas data).
VIE_RETENTION_MONTHS=12
